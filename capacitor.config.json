{
  "appId": "com.evdashboard.app",
  "appName": "EV Smart Dashboard",
  "webDir": "dist",
  "backgroundColor": "#0a0a0b",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 200,
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
