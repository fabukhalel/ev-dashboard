<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: نسخ بيانات التطبيق إلى Google Drive ونقلها عند تغيير الهاتف -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
